# ---- Data: never commit raw or derived datasets --------------------------
data/raw/*
data/interim/*
data/processed/*
!data/raw/README.md
!data/**/.gitkeep
*.csv.gz
*.zip

# ---- Trained models (regenerated by `python run_all.py`) -----------------
models/*
!models/.gitkeep

# ---- Python / tooling -----------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
*.log

# ---- Secrets and local settings ------------------------------------------
.env
.env.*
*.pem
*.key
.streamlit/secrets.toml
kaggle.json

# ---- OS -----------------------------------------------------------------
.DS_Store
Thumbs.db
